import math
import random

# 1. 自動微分引擎：Value 類別
class Value:
    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.grad = 0.0
        self._backward = lambda: None
        self._prev = set(_children)
        self._op = _op

    def __repr__(self):
        return f"Value({self.data:.4f}, grad={self.grad:.4f})"

    def __add__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data + other.data, (self, other), '+')
        
        def _backward():
            self.grad += 1.0 * out.grad
            other.grad += 1.0 * out.grad
        out._backward = _backward
        return out

    def __mul__(self, other):
        other = other if isinstance(other, Value) else Value(other)
        out = Value(self.data * other.data, (self, other), '*')
        
        def _backward():
            self.grad += other.data * out.grad
            other.grad += self.data * out.grad
        out._backward = _backward
        return out

    def __pow__(self, other):
        assert isinstance(other, (int, float)), "僅支援純數值次方"
        out = Value(self.data**other, (self,), f'**{other}')
        
        def _backward():
            self.grad += (other * (self.data ** (other - 1))) * out.grad
        out._backward = _backward
        return out

    def __radd__(self, other):
        return self + other

    def __rmul__(self, other):
        return self * other

    def __truediv__(self, other):
        return self * other**-1

    def __sub__(self, other):
        return self + (-other)

    def __neg__(self):
        return self * -1

    def exp(self):
        out = Value(math.exp(self.data), (self, ), 'exp')
        
        def _backward():
            self.grad += out.data * out.grad
        out._backward = _backward
        return out

    def log(self):
        out = Value(math.log(self.data), (self, ), 'log')
        
        def _backward():
            self.grad += (1.0 / self.data) * out.grad
        out._backward = _backward
        return out

    def backward(self):
        # 拓撲排序 (Topological Sort)
        topo = []
        visited = set()
        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for child in v._prev:
                    build_topo(child)
                topo.append(v)
        
        build_topo(self)
        self.grad = 1.0
        
        # 鏈式法則反向傳播
        for node in reversed(topo):
            node._backward()

# 2. 優化演算法：Adam 優化器
class Adam:
    def __init__(self, parameters, lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8):
        self.parameters = parameters
        self.lr = lr
        self.beta1 = beta1
        self.beta2 = beta2
        self.eps = eps
        self.m = [0.0] * len(parameters)
        self.v = [0.0] * len(parameters)
        self.t = 0

    def step(self):
        self.t += 1
        for i, p in enumerate(self.parameters):
            # 一階與二階動量
            self.m[i] = self.beta1 * self.m[i] + (1 - self.beta1) * p.grad
            self.v[i] = self.beta2 * self.v[i] + (1 - self.beta2) * (p.grad ** 2)

            # 偏差修正
            m_hat = self.m[i] / (1 - self.beta1 ** self.t)
            v_hat = self.v[i] / (1 - self.beta2 ** self.t)

            # 參數更新
            p.data -= self.lr * m_hat / (math.sqrt(v_hat) + self.eps)

    def zero_grad(self):
        for p in self.parameters:
            p.grad = 0.0

# 3. Transformer 關鍵組件
def rmsnorm(x):
    n = len(x)
    # 計算均方值並加上極小值防止除以零
    mean_sq = sum((v * v for v in x), Value(0.0)) * (1.0 / n)
    norm_factor = (mean_sq + 1e-5)**-0.5
    return [v * norm_factor for v in x]

def softmax(x):
    # 減去最大值以確保數值穩定性
    max_val = max(v.data for v in x)
    exps = [(v - max_val).exp() for v in x]
    sum_exps = sum(exps, Value(0.0))
    return [e / sum_exps for e in exps]

def linear(x, w, b):
    out = []
    for i in range(len(w)):
        row_sum = sum((w[i][j] * x[j] for j in range(len(x))), Value(0.0))
        out.append(row_sum + b[i])
    return out

# 4. 訓練流程：gd() 函式與神經網路建構
def forward_pass(x, w, b):
    # 將組件串聯：Linear -> RMSNorm
    x_lin = linear(x, w, b)
    x_norm = rmsnorm(x_lin)
    return x_norm

def gd(dataset, num_steps=100, initial_lr=0.05):
    # 定義網路結構：輸入層 2 個特徵，輸出層 2 個類別機率
    in_features = 2
    out_features = 2

    # 初始化權重與偏差
    w = [[Value(random.uniform(-1.0, 1.0)) for _ in range(in_features)] for _ in range(out_features)]
    b = [Value(random.uniform(-1.0, 1.0)) for _ in range(out_features)]

    # 展開所有需要訓練的參數交給優化器
    model_params = []
    for row in w:
        model_params.extend(row)
    model_params.extend(b)

    optimizer = Adam(model_params, lr=initial_lr)

    for step in range(1, num_steps + 1):
        # 實作學習率線性衰減
        optimizer.lr = initial_lr * (1 - step / num_steps)

        total_loss = 0.0
        correct = 0

        for x_data, target_id in dataset:
            # 將原始數據轉換為 Value 節點
            x_input = [Value(val) for val in x_data]

            # Forward Pass: 取得 Logits 並轉換為機率
            logits = forward_pass(x_input, w, b)
            probs = softmax(logits)

            # 記錄預測正確數
            pred_id = max(range(len(probs)), key=lambda i: probs[i].data)
            if pred_id == target_id:
                correct += 1

            # Loss Calculation: 負對數似然
            loss = -probs[target_id].log()
            total_loss += loss.data

            # Backward Pass
            optimizer.zero_grad()
            loss.backward()

            # Update
            optimizer.step()

        if step % 10 == 0 or step == 1:
            avg_loss = total_loss / len(dataset)
            accuracy = correct / len(dataset)
            print(f"Step {step:3d} | Loss: {avg_loss:.4f} | Accuracy: {accuracy * 100:.1f}%")

    return w, b

